# Copy this file to `.env` (same folder) and fill in real values.
# Never commit `.env` — it is ignored by git.

# Supabase: Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM provider: openai, openrouter, or fake (no AI calls, no cost)
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-mini
LLM_API_KEY=your-llm-api-key
# Free testing via OpenRouter (key from https://openrouter.ai/keys):
#   LLM_PROVIDER=openrouter
#   LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
#   LLM_API_KEY=sk-or-...

# Public HTTPS address of this server (e.g. your ngrok URL), no trailing slash
PUBLIC_BASE_URL=https://your-public-url.example.com

# DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO
