# Copy this file to `.env` (same folder) and fill in real values.
# Never commit `.env` — it is ignored by git.

# Supabase: Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM provider: openai, openrouter, gemini, or fake (no AI calls, no cost)
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-mini
LLM_API_KEY=your-llm-api-key
# Free testing via OpenRouter (key from https://openrouter.ai/keys):
#   LLM_PROVIDER=openrouter
#   LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
#   LLM_API_KEY=sk-or-...
# Google Gemini (key from https://aistudio.google.com/apikey):
#   LLM_PROVIDER=gemini
#   LLM_MODEL=<a Gemini model id, e.g. from `python -m scripts.try_llm --models`>
#   LLM_API_KEY=AIza...

# Public HTTPS address of this server (e.g. your ngrok URL), no trailing slash
PUBLIC_BASE_URL=https://your-public-url.example.com

# Channel catalog (Phase 8d): Supabase database webhooks for products and
# product_variants send this in the X-Webhook-Secret header. Any long random
# text, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(32))"
CATALOG_WEBHOOK_SECRET=your-catalog-webhook-secret

# DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO

# Limits (Phase 10). AI calls per store per day (D21): over it, typed
# messages go to staff. Messages per customer per minute: the rest are ignored.
AI_DAILY_CALLS_PER_STORE=300
CUSTOMER_MESSAGES_PER_MINUTE=20
